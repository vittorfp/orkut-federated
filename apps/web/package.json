{
  "name": "@orkut-federated/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "db:check": "tsx --env-file-if-exists=.env.local scripts/check-database.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:verify": "tsx --env-file-if-exists=.env.local scripts/verify-persistence.ts",
    "dev": "next dev",
    "format": "biome check --write .",
    "lint": "biome check .",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "worker": "tsx --env-file-if-exists=.env.local src/worker.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.17",
    "better-auth": "1.7.17",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.5",
    "pino": "^10.4.0",
    "postgres": "^4.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
